+def _write_atomic_csv(frame, path):
+    tmp = path + '.tmp'
+    with open(tmp, 'w', encoding='utf-8', newline='') as f:
+        frame.to_csv(f, index=False, lineterminator='\n')
+        f.flush()
+        os.fsync(f.fileno())
+    os.replace(tmp, path)
