+    cl = cs['clusters']
+    closes = df['Close'].values.astype(float)
+    rows = []
+    strata = [('<50', 0.0, 50.0), ('50-100', 50.0, 100.0), ('100-200', 100.0, 200.0), ('>200', 200.0, 1e12)]
