+                        'size_band': band, 'clusters': len(b), 'trades': tr,
+                        'WR_pct': round(100.0 * wn / tr, 1) if tr else 0.0,
+                        'net': round(float(b['net'].sum()), 1), 'N': n_tol,
+                        'population': 'BOOK (F0+F1 executed, gaps excluded)'})
+    return cl, pd.DataFrame(agg)
